rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(){return request.auth!=null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active==true && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role=='owner';}
  match /admins/{uid}{allow read:if request.auth!=null&&request.auth.uid==uid;allow write:if false;}
  match /portfolio/{id}{allow read:if resource.data.published==true||owner();allow create,update,delete:if owner();}
  match /brands/{id}{allow read:if resource.data.published==true||owner();allow create,update,delete:if owner();}
  match /packages/{id}{allow read:if resource.data.published==true||owner();allow create,update,delete:if owner();}
  match /messages/{id}{allow create:if request.resource.data.keys().hasOnly(['name','email','phone','service','message','status','createdAt'])&&request.resource.data.name is string&&request.resource.data.name.size()>=2&&request.resource.data.message is string&&request.resource.data.message.size()>=5&&request.resource.data.status=='new';allow read,update,delete:if owner();}
  match /siteSettings/{id}{allow read:if true;allow write:if owner();}
  match /analyticsEvents/{id}{allow read:if owner();allow create:if request.resource.data.type in ['page_view','lead']&&request.resource.data.createdAt==request.time;allow update,delete:if false;}
 }
}